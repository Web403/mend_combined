{
  "name": "mend-backend",
  "version": "1.0.0",
  "description": "Mend Backend - modular layered Node.js/TypeScript/Express/MongoDB boilerplate",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc --project ./tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "extract:api": "node dist/tools/api-extractor/cli.js",
    "report:api": "node dist/tools/api-extractor/cli.js --format markdown --out API_INVENTORY.md",
    "docs:api": "node dist/tools/api-extractor/cli.js --format html --out API_DOCS.html",
    "serve:api-docs": "node dist/tools/api-extractor/docs-server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:reviews": "ts-node src/scripts/migrate-reviews.ts"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "mongodb",
    "mongoose",
    "modular",
    "layered-architecture"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "*",
    "express": "*",
    "helmet": "*",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.3",
    "morgan": "*",
    "multer": "^2.2.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "pg-sdk-node": "https://phonepe.mycloudrepo.io/public/repositories/phonepe-pg-sdk-node/releases/v2/phonepe-pg-sdk-node-2.0.3.tgz",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "*",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "*",
    "@types/multer": "^2.0.0",
    "@types/node": "*",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-morph": "^26.0.0",
    "ts-node-dev": "*",
    "typescript": "*"
  }
}
